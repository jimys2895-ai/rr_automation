# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/rr_auto

# RoseRocket credentials
ROSEROCKET_ORG_URL=https://cetrucking.roserocket.com
ROSEROCKET_CLIENT_ID=your-client-id-uuid
ROSEROCKET_CLIENT_SECRET=your-client-secret
ROSEROCKET_USERNAME=your-email@example.com
ROSEROCKET_PASSWORD=your-password

# Fuel surcharge sync schedule (optional — defaults shown).
# Cron is 5-field; default = every day at 07:00. Timezone is an IANA name.
FUEL_SYNC_CRON=0 7 * * *
FUEL_SYNC_TZ=America/Toronto


# Motive (ELD) API key
MOTIVE_API_KEY=

# Google Sheets sync for the manifest-hours report.
# Either GOOGLE_SERVICE_ACCOUNT_KEY_FILE (path to the JSON key) or
# GOOGLE_SERVICE_ACCOUNT_JSON (the key inline). The sheet must be shared with the
# service account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json
HOURS_SHEET_ID=your-spreadsheet-id
HOURS_SHEET_TAB=Manifest Hours
HOURS_SYNC_DAYS=14
# Minutes between syncs (60 = hourly). A five-field cron expression also works, and
# `off` leaves scheduling to something external.
HOURS_SYNC_CRON=60
# Sync once when the server starts, so a restart does not leave the sheet stale for a
# whole interval. Set false under `npm run dev`, where nodemon restarts on every save.
HOURS_SYNC_ON_START=true
HOURS_SYNC_TZ=America/Toronto
